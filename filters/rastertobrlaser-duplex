Foundation, either version 2 of the License, or (at your option) any later
version.
"""

import os
import re
import subprocess
import sys

BRASER = "/usr/lib/cups/filter/rastertobrlaser"
CONFIG = "/etc/cups/lj2600d-duplex.conf"

# How much of the stream to buffer while looking for the prologue.  brlaser's
# prologue is well under 1 KiB, but leaving headroom keeps this robust if the
# PJL header ever grows.
HEAD_BYTES = 4096

RESET = b"\x1bE"                                  # PCL reset
PAPER_SOURCE = b"\x1b&l7H"                        # what the Lenovo driver sends
COPIES = re.compile(rb"\x1b&l\d+X")

MODES = {
    "simplex": b"0",
    "duplex-long-edge": b"1",
    "duplex-short-edge": b"2",
}

DUPLEX_OPTIONS = {
    "None": b"0",
    "DuplexNoTumble": b"1",
    "DuplexTumble": b"2",
}

SIDES_OPTIONS = {
    "one-sided": b"0",
    "two-sided-long-edge": b"1",
    "two-sided-short-edge": b"2",
}

DEFAULT_MODE = "duplex-long-edge"


def read_config_default():
    """Return the configured default mode, or None if there is no config."""
    try:
        with open(CONFIG, "r", encoding="utf-8") as handle:
            for line in handle:
                line = line.split("#", 1)[0].strip()
                if line.startswith("default"):
                    _, _, value = line.partition("=")
                    value = value.strip().strip("'\"")
                    if value in MODES:
                        return value
    except OSError:
        pass
    return None


def choose_mode(options):
    """Pick the PCL duplex value for this job."""
    parsed = {}
    for token in options.split():
        if "=" in token:
            key, value = token.split("=", 1)
            parsed[key] = value

    if parsed.get("Duplex") in DUPLEX_OPTIONS:
        return DUPLEX_OPTIONS[parsed["Duplex"]]
    if parsed.get("sides") in SIDES_OPTIONS:
        return SIDES_OPTIONS[parsed["sides"]]

    override = os.environ.get("LJ2600D_DUPLEX_DEFAULT")
    if override in MODES:
        return MODES[override]

    configured = read_config_default()
    if configured:
        return MODES[configured]

    return MODES[DEFAULT_MODE]


def rewrite_prologue(head, code):
    """Replace 'ESC E' with 'ESC & l 7 H ESC & l <code> S'.

    The paper source and duplex mode have to be in place before the copies
    command, so the reset is dropped rather than kept in front of them.
    """
    index = head.find(RESET)
    if index < 0:
        return head, False

    if not COPIES.search(head, index + len(RESET), index + 64):
        return head, False

    prologue = PAPER_SOURCE + b"\x1b&l" + code + b"S"
    return head[:index] + prologue + head[index + len(RESET):], True


def main():
    argv = sys.argv
    options = argv[5] if len(argv) > 5 else ""
    code = choose_mode(options)

    if not os.access(BRASER, os.X_OK):
        sys.stderr.write(
            "rastertobrlaser-duplex: %s not found; install printer-driver-brlaser\n"
            % BRASER
        )
        return 1

    # brlaser inherits stderr so its own diagnostics still reach the CUPS log.
    child = subprocess.Popen([BRASER] + argv[1:], stdout=subprocess.PIPE)

    out = sys.stdout.buffer
    head = b""
    while len(head) < HEAD_BYTES:
        chunk = child.stdout.read(HEAD_BYTES - len(head))
        if not chunk:
            break
        head += chunk

    head, patched = rewrite_prologue(head, code)
    out.write(head)

    while True:
        chunk = child.stdout.read(65536)
        if not chunk:
            break
        out.write(chunk)
    out.flush()

    if head and not patched:
        sys.stderr.write(
            "rastertobrlaser-duplex: no 'ESC E ... ESC & l <n> X' prologue "
            "found, job sent unmodified (duplex will not work)\n"
        )

    return child.wait()


if __name__ == "__main__":
    sys.exit(main())
